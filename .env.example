OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=openai/gpt-5.6-luna
AGENT_MAX_STEPS=30
AGENT_TASK_TIMEOUT=300
DATA_DIR=/data

# Auth (session cookie). Better Auth is TS-only; this is the FastAPI equivalent.
APP_USERNAME=admin
APP_PASSWORD=change-me
APP_AUTH_TOKEN=
AUTH_SECRET=change-me-long-random
AUTH_COOKIE_SECURE=true

# VNC
VNC_VIEW_ONLY=true
